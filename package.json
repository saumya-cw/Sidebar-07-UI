{
	"name": "sidebar-07-ui",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"check-types": "tsc -b",
		"fun": "bun check:fix && bun check-types",
